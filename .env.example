PORT=3000
NODE_ENV=development
SESSION_SECRET=replace_with_at_least_32_random_characters
TRUST_PROXY=0
DATABASE_PATH=./data/app.db
SUPERADMIN_EMAIL=owner@example.com

# Vercel note:
# If DATABASE_PATH is not set on Vercel, the app uses /tmp/ask-her-out/app.db.
# That keeps the deployment bootable, but data/uploads are temporary on Vercel.
